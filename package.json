{
  "name": "rhud",
  "version": "0.1.0",
  "description": "Iron Man-style hand-tracked HUD. POV camera in, sci-fi reticles out.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "dev:lan": "RHUD_LAN=1 vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "shadercheck": "node scripts/shadercheck.mjs",
    "assets": "node scripts/fetch-assets.mjs",
    "postinstall": "node scripts/fetch-assets.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.0.1",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  }
}
